{
  "name": "kimpc-server",
  "version": "1.0.0",
  "description": "KIMPC - Kalilangan Irrigators Multi-Purpose Cooperative backend Express & MongoDB server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-path=server.js --watch-path=app.js --watch-path=config --watch-path=routes --watch-path=models --watch-path=services --watch-path=controllers --watch-path=middleware --watch-path=utils server.js",
    "seed": "node seed.js",
    "db:check": "node scripts/db-inspect.js",
    "db:seed": "node seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "db:backfill-version": "node scripts/backfill-version.js"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "client": "^0.0.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "googleapis": "^188.0.0",
    "jsonwebtoken": "^9.0.3",
    "kimpc": "file:..",
    "mongoose": "^9.11.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "resend": "^6.37.0",
    "server": "^1.0.42"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
