# Copy this file to ".env" and fill in your own values.
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/minders
# Local:  mongodb://127.0.0.1:27017/minders
MONGODB_URI=mongodb://127.0.0.1:27017/minders
PORT=3000

# Google OAuth 2.0 Client ID & Secret (from Google Cloud Console -> Credentials)
# Default Keys (Non-editable code defaults / fallback)
DEFAULT_GOOGLE_CLIENT_ID=
DEFAULT_GOOGLE_CLIENT_SECRET=
# Customizable Keys (Input by Admin in Portal Settings)
CUSTOM_GOOGLE_CLIENT_ID=""
CUSTOM_GOOGLE_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit redirect URI (must match Google Cloud Console Authorized Redirect URIs)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Facebook Login API App Credentials
# Default Keys (Non-editable code defaults / fallback)
DEFAULT_FACEBOOK_APP_ID=
DEFAULT_FACEBOOK_APP_SECRET=
# Customizable Keys (Input by Admin in Portal Settings)
CUSTOM_FACEBOOK_APP_ID=""
CUSTOM_FACEBOOK_APP_SECRET=""
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google reCAPTCHA v2 configuration (Test keys provided by default)
# For production, obtain keys from https://www.google.com/recaptcha/admin
# Default Keys (Non-editable code defaults / fallback)
DEFAULT_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
DEFAULT_RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Customizable Keys (Input by Admin in Portal Settings)
CUSTOM_RECAPTCHA_SITE_KEY=""
CUSTOM_RECAPTCHA_SECRET_KEY=""
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Set to false to disable verification during local testing if offline:
RECAPTCHA_ENABLED=true

# Optional member support contact and email delivery
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Email Service Configuration
# Resend API (Primary email provider)
RESEND_API_KEY=
EMAIL_FROM=KIMPC Security <onboarding@resend.dev>

# Fallback SMTP configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend Application Base URL (Used for constructing password reset links)
APP_BASE_URL=http://localhost:5173

# Password reset token expiry in minutes (defaults to 5)
PASSWORD_RESET_EXPIRY_MINUTES=5

# Cloudinary Media Storage Configuration
# Default Keys (Non-editable code defaults / fallback)
DEFAULT_CLOUDINARY_CLOUD_NAME=your_cloud_name
DEFAULT_CLOUDINARY_API_KEY=691365116427346
DEFAULT_CLOUDINARY_API_SECRET=0aNAAV2XYUo_0xyuHa6WUfhKKnY
# Customizable Keys (Input by Admin in Portal Settings)
CUSTOM_CLOUDINARY_CLOUD_NAME=""
CUSTOM_CLOUDINARY_API_KEY=""
CUSTOM_CLOUDINARY_API_SECRET=""
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OneSignal Web Push Configuration
# Default Keys (Non-editable code defaults / fallback)
DEFAULT_ONESIGNAL_APP_ID=fc811113-559c-40c3-ba59-e703db896839
DEFAULT_ONESIGNAL_REST_KEY=your_onesignal_rest_api_key
# Customizable Keys (Input by Admin in Portal Settings)
CUSTOM_ONESIGNAL_APP_ID=""
CUSTOM_ONESIGNAL_REST_KEY=""
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# WeatherAPI.com Configuration (for 3-day Kalilangan weather forecast)
# Default Key (Non-editable code default / fallback)
DEFAULT_WEATHER_API_KEY=
# Customizable Key (Input by Admin in Portal Settings)
CUSTOM_WEATHER_API_KEY=""
WEATHER_API_KEY=
