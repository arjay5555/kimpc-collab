{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend Server (Minders Express)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/Minders-mongodb",
      "program": "${workspaceFolder}/Minders-mongodb/server.js",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Frontend (Chrome / Edge)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/Minders-mongodb/client"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Chrome)",
      "configurations": ["Debug Backend Server (Minders Express)", "Debug Frontend (Chrome / Edge)"]
    }
  ]
}

