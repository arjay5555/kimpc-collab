# Copy this file to ".env" and fill in your own values.
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/minders
# Local:  mongodb://127.0.0.1:27017/minders
MONGODB_URI=mongodb://127.0.0.1:27017/minders
PORT=3000

# Google OAuth 2.0 Client ID (from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=

# Facebook Login API App Credentials
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google reCAPTCHA v2 configuration (Test keys provided by default)
# For production, obtain keys from https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Set to false to disable verification during local testing if offline:
RECAPTCHA_ENABLED=true

# Optional member support contact and email delivery
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Email Service Configuration
# Resend API (Primary email provider)
RESEND_API_KEY=
EMAIL_FROM=KIMPC Security <onboarding@resend.dev>

# Fallback SMTP configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend Application Base URL (Used for constructing password reset links)
APP_BASE_URL=http://localhost:5173

# Password reset token expiry in minutes (defaults to 30)
PASSWORD_RESET_EXPIRY_MINUTES=30
