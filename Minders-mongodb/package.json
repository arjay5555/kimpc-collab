{
  "name": "kimpc",
  "version": "1.0.0",
  "description": "KIMPC - Kalilangan Irrigators Multi-Purpose Cooperative machinery portal with a MongoDB backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-path=server.js --watch-path=routes --watch-path=models --watch-path=services server.js",
    "build": "npm --prefix client run build",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:dev": "npm --prefix client run dev",
    "seed": "node seed.js"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "googleapis": "^188.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "resend": "^6.37.0"
  }
}
